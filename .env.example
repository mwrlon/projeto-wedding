# Copie para .env e ajuste. NUNCA faça commit do .env.

NODE_ENV=development
PORT=3000

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=wedding_pass
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens do front autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Rate limit: janela em ms, máximo geral e máximo de logins falhos por janela
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Atrás de proxy reverso (nginx, Render, Railway...) use 1
TRUST_PROXY=0

BCRYPT_ROUNDS=12
